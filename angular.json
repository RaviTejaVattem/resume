{
  "version": 1,
  "projects": {
    "resume": {
      "root": "apps/resume",
      "sourceRoot": "apps/resume/src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/resume",
            "index": "apps/resume/src/index.html",
            "main": "apps/resume/src/main.ts",
            "polyfills": "apps/resume/src/polyfills.ts",
            "tsConfig": "apps/resume/tsconfig.app.json",
            "assets": ["apps/resume/src/favicon.ico", "apps/resume/src/assets"],
            "styles": ["apps/resume/src/styles.css", "apps/resume/src/design.css", "apps/resume/src/print.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "browserTarget": "resume:build" },
          "configurations": {
            "production": { "browserTarget": "resume:build:production" },
            "development": { "browserTarget": "resume:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
